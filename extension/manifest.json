{
  "manifest_version": 3,
  "name": "popcornpals sync",
  "version": "0.1.0",
  "description": "Keeps the video player on a streaming site in step with your popcornpals room. Everyone watches with their own account.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "popcornpals sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://kwy404.github.io/popcornpals/app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
